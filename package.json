{
  "name": "quotevault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-client-env.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s scripts/import -p 'test_*.py'",
    "test:edge": "deno check supabase/functions/vault-security/index.ts && deno test --allow-net=127.0.0.1 --allow-env supabase/functions/vault-security/index.test.ts",
    "build:smoke": "VITE_SUPABASE_URL=http://127.0.0.1:54329 VITE_SUPABASE_ANON_KEY=local-test-key VITE_DEVICE_LEASE_PUBLIC_JWK='{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"QjM2-RC4L30GHX65OHkHWNTj-C35S3JbP2B8RyqDOo0\",\"y\":\"80p6ndkl3Kc9IsD5Bp6vcGgl79lWldtXgLGU8nvkS3U\"}' npm run build -- --outDir dist-smoke.local",
    "test:browser": "playwright test",
    "test:database": "bash scripts/test-database.sh",
    "import:prepare": "python3 scripts/import/prepare.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}
